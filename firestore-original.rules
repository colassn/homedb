rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function validMemo() {
      let d = request.resource.data;
      return d.keys().hasAll(['title','note','done','createdAt','updatedAt'])
        && d.keys().hasOnly(['title','note','done','createdAt','updatedAt','version','operation','deleted'])
        && (!('version' in d) || (d.version is int && d.version >= 1))
        && (!('operation' in d) || (d.operation is string && d.operation.size() <= 64))
        && (!('deleted' in d) || d.deleted is bool)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.note is string && d.note.size() <= 10000 && d.done is bool
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function versionCreate() { return !('version' in request.resource.data) || request.resource.data.version == 1; }
    function versionUpdate() { return !('version' in resource.data)
      ? (!('version' in request.resource.data) || request.resource.data.version == 1)
      : ('version' in request.resource.data && request.resource.data.version == resource.data.version + 1); }
    match /users/{uid}/memos/{memoId} {
      function owner() { return signed() && request.auth.uid == uid; }
      allow read: if owner();
      allow create: if owner() && validMemo() && versionCreate() && request.resource.data.createdAt == request.time;
      allow update: if owner() && validMemo() && versionUpdate() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /pairInvites/{token} {
      // Unpredictable 128-bit token, get only; no enumeration.
      allow get: if signed();
      allow list, delete: if false;
      allow create: if signed() && token.matches('[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['owner','space','guest','expiresAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.guest == ''
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(11,'m')
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.space)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.space)).data.invite == token;
      allow update: if signed() && resource.data.guest == ''
        && resource.data.owner != request.auth.uid && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest'])
        && request.resource.data.guest == request.auth.uid
        && getAfter(/databases/$(database)/documents/spaces/$(resource.data.space)).data.members == [resource.data.owner,request.auth.uid];
    }
    match /spaces/{space} {
      function member() { return signed() && request.auth.uid in resource.data.members; }
      allow get: if signed() && (!exists(/databases/$(database)/documents/spaces/$(space)) || member());
      allow list, delete: if false;
      allow create: if signed() && request.resource.data.keys().hasOnly(['owner','members','invite'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.invite is string;
      allow update: if signed() && (
        (member() && resource.data.members.size() == 2
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == [resource.data.owner]) ||
        (resource.data.owner == request.auth.uid && resource.data.members == [request.auth.uid]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invite'])
          && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.invite)).data.owner == request.auth.uid
          && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.invite)).data.space == space)
        || (resource.data.members == [resource.data.owner] && resource.data.owner != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == [resource.data.owner,request.auth.uid]
          && get(/databases/$(database)/documents/pairInvites/$(resource.data.invite)).data.space == space
          && get(/databases/$(database)/documents/pairInvites/$(resource.data.invite)).data.expiresAt > request.time
          && get(/databases/$(database)/documents/pairInvites/$(resource.data.invite)).data.guest == ''
          && getAfter(/databases/$(database)/documents/pairInvites/$(resource.data.invite)).data.guest == request.auth.uid)
      );
      match /devices/{uid} {
        function access() { return signed() && request.auth.uid in get(/databases/$(database)/documents/spaces/$(space)).data.members; }
        allow read: if access();
        allow create, update: if access() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['model','name','lastSeen'])
          && request.resource.data.model is string && request.resource.data.model.size() <= 160
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && request.resource.data.lastSeen == request.time;
        allow delete: if false;
      }
      match /memos/{memoId} {
        function access() { return signed() && request.auth.uid in get(/databases/$(database)/documents/spaces/$(space)).data.members; }
        allow read: if access();
        allow create: if access() && validMemo() && versionCreate() && request.resource.data.createdAt == request.time;
        allow update: if access() && validMemo() && versionUpdate() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
